rules_version = '1';

// ═══════════════════════════════════════════════════════════════════════════
// firestore.rules — Invenxio
//
// Estructura real de la app (ver src/services/firestoreService.js):
//   users/{uid}                                  → perfil (companyId, role, permissions, active)
//   companies/{companyId}                        → datos de la empresa (name, ownerId, plan, billing)
//   companies/{companyId}/meta/subscription      → el Dueño solo puede CREARLO (prueba gratis inicial); luego solo Admin SDK (api/culqi-charge.js, api/mercadopago-webhook.js) puede escribir
//   companies/{companyId}/meta/invoiceCounter    → contador atómico de comprobantes
//   companies/{companyId}/products/{id}
//   companies/{companyId}/products/{id}/history/{id}  → log inmutable
//   companies/{companyId}/suppliers/{id}
//   companies/{companyId}/transactions/{id}      → log inmutable (ventas y compras)
//   companies/{companyId}/supplierSales/{id}
//   companies/{companyId}/warehouseLocations/{id}
//   companies/{companyId}/warehouseStock/{id}
//   companies/{companyId}/warehouseMovements/{id}     → log inmutable
//   companies/{companyId}/warehouseProducts/{id}
//
// Roles: "owner" (todos los permisos, único que gestiona equipo/facturación)
//        "empleado" (permisos granulares — ver src/config/permissions.js)
//
// ⚠️ IMPORTANTE: la lista PERMISSION_KEYS de abajo debe mantenerse igual a
// ALL_PERMISSION_KEYS en src/config/permissions.js. Si agregas un permiso
// nuevo ahí, agrégalo también acá o esas reglas lo ignorarán.
// ═══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Un usuario "activo" es el único que puede leer/escribir datos de su
    // empresa. Un empleado desactivado (active:false) queda bloqueado acá
    // también, no solo expulsado del lado del cliente (ver AuthContext).
    function isActive() {
      return isSignedIn() && profileExists(request.auth.uid) && myProfile().active == true;
    }

    function myCompanyId() {
      return myProfile().companyId;
    }

    function isSameCompany(companyId) {
      return isActive() && myCompanyId() == companyId;
    }

    function isOwner(companyId) {
      return isSameCompany(companyId) && myProfile().role == 'owner';
    }

    // Dueño = todos los permisos. Empleado = solo lo que tenga en su mapa
    // `permissions`, usando .get(key, false) para no fallar si falta la key.
    function hasPerm(companyId, key) {
      return isOwner(companyId)
        || (isSameCompany(companyId) && myProfile().get('permissions', {}).get(key, false) == true);
    }

    // Todas las claves de permiso válidas (debe reflejar permissions.js).
    function validPermissionKeys() {
      return [
        'ver_inventario', 'crear_productos', 'editar_productos',
        'registrar_ventas', 'registrar_compras',
        'ver_almacen', 'gestionar_almacen',
        'ver_proveedores', 'gestionar_proveedores',
        'ver_metricas_financieras', 'eliminar_registros'
      ];
    }

    // Permisos por defecto (defaultPermissions() en permissions.js): solo
    // ver_inventario y registrar_ventas empiezan en true, el resto en false.
    function isDefaultPermissionsMap(perms) {
      return perms == {
        'ver_inventario': true, 'crear_productos': false, 'editar_productos': false,
        'registrar_ventas': true, 'registrar_compras': false,
        'ver_almacen': false, 'gestionar_almacen': false,
        'ver_proveedores': false, 'gestionar_proveedores': false,
        'ver_metricas_financieras': false, 'eliminar_registros': false
      };
    }

    // ── USERS/{uid} ────────────────────────────────────────────────────────
    match /users/{uid} {
      // Cada quien lee su propio perfil; el Dueño además lee los perfiles de
      // su equipo (RolePanel → subscribeToEmployees, solo visible si isOwner
      // en la UI, pero la regla lo exige también del lado del servidor).
      allow read: if isSignedIn() && (
        request.auth.uid == uid || isOwner(resource.data.companyId)
      );

      // Alta de cuenta nueva. Pasa en dos casos (ver AuthContext.jsx):
      //   a) register(): el propio usuario funda su empresa → role "owner",
      //      companyId == su propio uid.
      //   b) registerEmployee()/loginWithGoogle() primera vez: se crea el
      //      perfil de un empleado con permisos GRANULARES.
      //
      // ⚠️ Nota de seguridad: como esta escritura ocurre con el uid del
      // propio usuario nuevo (incluso cuando la inicia el Dueño, ver la app
      // secundaria de Firebase en registerEmployee), no hay forma de que la
      // regla verifique "quién realmente decidió agregarlo". Para no dejar
      // que cualquiera se autoasigne permisos altos a una empresa ajena
      // sabiendo su companyId, esta regla OBLIGA a que los permisos de
      // creación sean siempre los de defaultPermissions() — la elevación real
      // de permisos solo puede pasar después, vía updateUserPermissions(),
      // que exige ser el Dueño de esa empresa (ver match de "update" abajo).
      // Esto requiere un pequeño ajuste en el cliente: después de
      // registerEmployee(), el Dueño debe llamar updateUserPermissions(uid,
      // permisosElegidos) para aplicar los permisos reales elegidos en el
      // formulario.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.active == true
        && request.resource.data.role in ['owner', 'empleado']
        && (
          (request.resource.data.role == 'owner'
            && request.resource.data.companyId == uid)
          ||
          (request.resource.data.role == 'empleado'
            && request.resource.data.companyId is string
            && request.resource.data.companyId != uid
            && isDefaultPermissionsMap(request.resource.data.permissions))
        );

      // Solo el Dueño de la MISMA empresa puede tocar el perfil de un
      // empleado — y solo los campos permissions/active/updatedAt. No puede
      // cambiarle el companyId (moverlo a otra empresa) ni el role.
      allow update: if isOwner(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['permissions', 'active', 'updatedAt'])
        && (
          !('permissions' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.permissions.keys().hasOnly(validPermissionKeys()))
        );

      // No hay función en la app para borrar un perfil (solo desactivarlo).
      allow delete: if false;
    }

    // ── COMPANIES/{companyId} ─────────────────────────────────────────────
    match /companies/{companyId} {

      allow read: if isSameCompany(companyId);

      // createCompany(): el usuario recién registrado crea el doc de SU
      // propia empresa (id == su propio uid), siempre con plan "free" y sin
      // billing todavía.
      allow create: if isSignedIn() && request.auth.uid == companyId
        && request.resource.data.ownerId == companyId
        && request.resource.data.plan == 'free'
        && request.resource.data.name is string;

      // updateCompanyBilling(): solo el Dueño, y solo puede tocar billing/
      // updatedAt/name — nunca ownerId ni plan (el plan real de pago vive en
      // meta/subscription y solo lo cambia el backend de Culqi).
      //
      // updateCompanyCountry(): el Dueño también puede cambiar país/moneda/
      // pasarela (ver "Mis Datos" → RolePanel.jsx) — pero los 3 campos deben
      // llegar siempre juntos y coincidir entre sí según countryConfig.js,
      // para que nadie pueda mandar, por ejemplo, país "Argentina" con
      // pasarela "culqi" (que es exclusiva de Perú).
      allow update: if isOwner(companyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['billing', 'updatedAt', 'name', 'country', 'paymentGateway', 'currencyCode', 'currencySymbol'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['country', 'paymentGateway', 'currencyCode', 'currencySymbol'])
          || (request.resource.data.country == 'PE'
                ? request.resource.data.paymentGateway == 'culqi'  && request.resource.data.currencyCode == 'PEN' && request.resource.data.currencySymbol == 'S/'
                : request.resource.data.paymentGateway == 'mercadopago' && request.resource.data.currencyCode == 'USD' && request.resource.data.currencySymbol == '$'
             )
        );

      allow delete: if false;

      // ── meta/subscription: creación única permitida, todo lo demás NO ──
      // El Dueño puede CREAR este documento (una sola vez, con los valores
      // exactos de la prueba gratis) al registrar su empresa — ver el paso 3
      // de createCompany() en services/firestore/companies.js. Cualquier
      // cambio posterior (empezar a cobrar, renovar, marcar como vencido)
      // ocurre siempre con el Admin SDK del backend de pagos
      // (api/culqi-charge.js, api/mercadopago-webhook.js, api/grant-
      // access.js), que ignora estas reglas por completo — por eso "update"
      // queda bloqueado incluso para el propio Dueño.
      match /meta/subscription {
        allow read: if isSameCompany(companyId);
        allow create: if isOwner(companyId)
          && request.resource.data.status == 'trial'
          && request.resource.data.plan == 'trial';
        allow update: if false;
      }

      // ── meta/invoiceCounter: incremento atómico validado ────────────────
      match /meta/invoiceCounter {
        allow read: if hasPerm(companyId, 'registrar_ventas') || hasPerm(companyId, 'registrar_compras');

        allow create: if (hasPerm(companyId, 'registrar_ventas') || hasPerm(companyId, 'registrar_compras'))
          && request.resource.data.value == 1;

        allow update: if (hasPerm(companyId, 'registrar_ventas') || hasPerm(companyId, 'registrar_compras'))
          && request.resource.data.value == resource.data.value + 1;
      }

      // ── PRODUCTOS (tienda) ───────────────────────────────────────────────
      match /products/{productId} {
        allow read: if hasPerm(companyId, 'ver_inventario') || hasPerm(companyId, 'crear_productos') || hasPerm(companyId, 'editar_productos');
        allow create: if hasPerm(companyId, 'crear_productos');
        // editar_productos cubre ediciones de catálogo; registrar_ventas/
        // registrar_compras cubren SOLO los descuentos/aumentos de stock que
        // hacen recordSale/recordPurchase/adjustProductStock.
        allow update: if hasPerm(companyId, 'editar_productos') || hasPerm(companyId, 'registrar_ventas') || hasPerm(companyId, 'registrar_compras');
        allow delete: if hasPerm(companyId, 'eliminar_registros');

        match /history/{entryId} {
          allow read: if hasPerm(companyId, 'ver_inventario') || hasPerm(companyId, 'crear_productos') || hasPerm(companyId, 'editar_productos');
          allow create: if hasPerm(companyId, 'editar_productos') || hasPerm(companyId, 'registrar_ventas') || hasPerm(companyId, 'registrar_compras');
          allow update, delete: if false; // log inmutable
        }
      }

      // ── PROVEEDORES ──────────────────────────────────────────────────────
      match /suppliers/{supplierId} {
        allow read: if hasPerm(companyId, 'ver_proveedores') || hasPerm(companyId, 'gestionar_proveedores');
        // recordPurchase() actualiza totalOrders/totalSpent del proveedor
        // aunque quien compra solo tenga registrar_compras.
        allow create, update: if hasPerm(companyId, 'gestionar_proveedores') || hasPerm(companyId, 'registrar_compras');
        allow delete: if hasPerm(companyId, 'eliminar_registros');
      }

      // ── TRANSACCIONES (ventas y compras) — log inmutable ────────────────
      match /transactions/{txId} {
        allow read: if hasPerm(companyId, 'registrar_ventas') || hasPerm(companyId, 'registrar_compras') || hasPerm(companyId, 'ver_metricas_financieras');
        allow create: if hasPerm(companyId, 'registrar_ventas') || hasPerm(companyId, 'registrar_compras');
        allow update, delete: if false;
      }

      // ── VENTAS A PROVEEDORES ─────────────────────────────────────────────
      match /supplierSales/{saleId} {
        allow read: if hasPerm(companyId, 'ver_proveedores') || hasPerm(companyId, 'gestionar_proveedores');
        allow create, update: if hasPerm(companyId, 'gestionar_proveedores');
        allow delete: if false;
      }

      // ── ALMACÉN ──────────────────────────────────────────────────────────
      match /warehouseLocations/{locId} {
        allow read: if hasPerm(companyId, 'ver_almacen') || hasPerm(companyId, 'gestionar_almacen');
        allow write: if hasPerm(companyId, 'gestionar_almacen');
      }

      match /warehouseStock/{stockId} {
        allow read: if hasPerm(companyId, 'ver_almacen') || hasPerm(companyId, 'gestionar_almacen');
        // gestionar_almacen: ajustes manuales / recepción de almacén.
        // registrar_compras: recordWarehousePurchase() suma stock al comprar.
        // gestionar_proveedores: sellWarehouseToSupplier() descuenta stock.
        allow create, update: if hasPerm(companyId, 'gestionar_almacen') || hasPerm(companyId, 'registrar_compras') || hasPerm(companyId, 'gestionar_proveedores');
        allow delete: if hasPerm(companyId, 'eliminar_registros');
      }

      match /warehouseMovements/{moveId} {
        allow read: if hasPerm(companyId, 'ver_almacen') || hasPerm(companyId, 'gestionar_almacen');
        allow create: if hasPerm(companyId, 'gestionar_almacen') || hasPerm(companyId, 'registrar_compras') || hasPerm(companyId, 'gestionar_proveedores');
        allow update, delete: if false; // log inmutable
      }

      match /warehouseProducts/{productId} {
        allow read: if hasPerm(companyId, 'ver_almacen') || hasPerm(companyId, 'gestionar_almacen');
        allow create, update: if hasPerm(companyId, 'gestionar_almacen');
        allow delete: if hasPerm(companyId, 'gestionar_almacen') || hasPerm(companyId, 'eliminar_registros');
      }
    }
  }
}
