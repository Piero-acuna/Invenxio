# ── Variables del NAVEGADOR (prefijo VITE_ = quedan visibles en el bundle) ──
# Firebase — esto NO es secreto, Firebase está diseñado para que esta
# configuración sea pública; la seguridad real vive en firestore.rules.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=

# Culqi — Llave PÚBLICA (pk_...). Esta sí puede estar en el navegador, está
# diseñada para eso. Sácala de: Culqi → Llaves API → Llave Pública.
VITE_CULQI_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Variables del SERVIDOR (solo para api/culqi-charge.js en Vercel).
# NUNCA les pongas el prefijo VITE_, y NUNCA las escribas acá con su valor
# real — configúralas directo en Vercel → Settings → Environment Variables.
# Se listan aquí solo como referencia de qué nombres espera el código.
# ─────────────────────────────────────────────────────────────────────────
# CULQI_SECRET_KEY=          (sk_..., Culqi → Llaves API → Llave Secreta)
# FIREBASE_PROJECT_ID=       (del JSON de la cuenta de servicio de Firebase)
# FIREBASE_CLIENT_EMAIL=     (idem)
# FIREBASE_PRIVATE_KEY=      (idem — incluye los saltos de línea)
